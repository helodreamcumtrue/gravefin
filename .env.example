# Project Graveyard Environment Variables

# 1. Local SQLite Database (Default, zero setup required)
DATABASE_URL="file:./dev.db"

# 2. Production Neon PostgreSQL Database (To switch to Neon Postgres on Vercel):
# Change datasource provider in prisma/schema.prisma to "postgresql"
# DATABASE_URL="postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/graveyard?sslmode=require"

# System Automation & Cron Secret
CRON_SECRET="graveyard_secret_key"
NEXT_PUBLIC_APP_NAME="Project Graveyard"
